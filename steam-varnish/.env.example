# Point client DNS for lancache.steamcontent.com to this machine.
LISTEN_ADDRESS=0.0.0.0
HTTP_PORT=80

# Actual disk space is allocated at startup. Must fit on CACHE_DIR's filesystem.
# Bytes or binary K/M/G/T suffixes; use a multiple of the host's page size.
CACHE_DIR=./cache
CACHE_SIZE=100G
TRANSIENT_SIZE=256M
CACHE_TTL_SECONDS=2592000

# Requests use the client's HTTP Host as the upstream, including its port.
# These resolvers must return actual CDN addresses, not the cache server.
UPSTREAM_DNS=1.1.1.1 1.0.0.1
MAX_REDIRECTS=5
