# Transaction state survives native redirects; client headers cannot set it.
cond %{READ_REQUEST_HDR_HOOK}
  set-state-int16 0 1

cond %{READ_REQUEST_HDR_HOOK}
cond %{CLIENT-URL:PATH} /^depot\/[0-9]+\/chunk\/[a-fA-F0-9]+$/ [NOT]
  set-state-int16 0 0
  set-config proxy.config.http.cache.http 0
  set-config proxy.config.http.cache.max_open_read_retries -1
  set-config proxy.config.http.cache.open_write_fail_action 0

# Do not cache authenticated requests or forward their credentials on redirects.
cond %{READ_REQUEST_HDR_HOOK}
cond %{CLIENT-HEADER:Authorization} ="" [NOT]
  set-state-int16 0 0
  set-config proxy.config.http.cache.http 0
  set-config proxy.config.http.cache.max_open_read_retries -1
  set-config proxy.config.http.cache.open_write_fail_action 0
  set-config proxy.config.http.number_of_redirections 0

cond %{READ_REQUEST_HDR_HOOK}
cond %{CLIENT-HEADER:Cookie} ="" [NOT]
  set-state-int16 0 0
  set-config proxy.config.http.cache.http 0
  set-config proxy.config.http.cache.max_open_read_retries -1
  set-config proxy.config.http.cache.open_write_fail_action 0
  set-config proxy.config.http.number_of_redirections 0

# Store full Steam chunks even when a miss was triggered by a byte range.
# ATS retains the client's Range and generates the appropriate 206 response.
cond %{SEND_REQUEST_HDR_HOOK}
cond %{STATE-INT16:0} =1
  rm-header Range
  rm-header If-Range

# Never store partial objects, errors or intermediate redirects as full chunks.
cond %{READ_RESPONSE_HDR_HOOK}
cond %{STATUS} =200
  set-http-cntl SERVER_NO_STORE off
else
  set-http-cntl SERVER_NO_STORE on

cond %{SEND_RESPONSE_HDR_HOOK}
  set-header X-Cache %{CACHE}

cond %{SEND_RESPONSE_HDR_HOOK}
cond %{CLIENT-URL:PATH} =lancache-heartbeat
  set-header X-LanCache-Processed-By @@CACHE_ID@@
  set-header Access-Control-Allow-Origin *
  set-header Access-Control-Expose-Headers *
  set-header Cache-Control no-store
