LISTEN_ADDRESS=0.0.0.0
HTTP_PORT=80

# Dedicated ATS cache directory: do not share the Varnish file.
# The full file is allocated at startup. Use a multiple of 128 MiB, at least 256M.
CACHE_DIR=./cache
CACHE_SIZE=100G
RAM_CACHE_SIZE=256M
# Fallback freshness for chunks without explicit origin freshness headers.
CACHE_TTL_SECONDS=2592000

UPSTREAM_HOST=dl.steam.clngaa.com
UPSTREAM_PORT=80
UPSTREAM_SCHEME=http
UPSTREAM_DNS=1.1.1.1 1.0.0.1
MAX_REDIRECTS=5

# Concurrent cold misses wait for the writer instead of fetching another copy.
OPEN_READ_RETRIES=100
OPEN_READ_RETRY_MS=50
RWW_RETRIES=100
RWW_RETRY_MS=50
ATS_THREADS=4
